# VoiceFlow Environment Configuration

# Speech & TTS Provider (Rime AI)
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL=arcana
RIME_VOICE=astra
RIME_ENDPOINT=https://api.rime.ai/v1/rime-tts
RIME_SAMPLING_RATE=16000
RIME_AUDIO_FORMAT=wav

# AI / LLM Configuration
# AI_PROVIDER options: gemini | openai | groq | mock
AI_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq API (Optional, for ultra-low latency voice)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Server Config
PORT=8000
HOST=0.0.0.0
