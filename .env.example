# ==============================================================================
# VoiceFlow Environment Configuration
# Full-Duplex Voice Agent with Interruption Recovery (Rime Hackathon)
# NOTE: DO NOT commit actual secrets to version control.
# ==============================================================================

# Rime AI TTS Configuration (Required for Live Cloud Synthesis)
# Models: "arcana" (bilingual Hindi-English), "mist-v3" (low-latency 40ms)
# Voices: "astra" (friendly, conversational), "brisk" (professional)
RIME_API_KEY=your_rime_api_key_here
RIME_MODEL=arcana
RIME_VOICE=astra
RIME_ENDPOINT=https://api.rime.ai/v1/rime-tts
RIME_WS_ENDPOINT=wss://api.rime.ai/v1/ws
RIME_AUDIO_FORMAT=wav
RIME_SAMPLING_RATE=16000

# LiveKit WebRTC Transport (Optional for WebRTC mode / LiveKit Cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# LLM Provider Configuration
# Supported: "groq" (recommended for ultra-low latency) or "openai"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Speech-To-Text (STT) Provider Configuration
# Supported: "deepgram" or "assemblyai"
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Server Configuration
PORT=8000
HOST=0.0.0.0
SIMULATION_MODE=true
